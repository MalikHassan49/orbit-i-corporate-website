# Root-level reference for docker-compose. Copy to .env and fill in real
# values before running `docker compose up`. Client and server each also
# have their own .env.example for local (non-Docker) development.

JWT_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
CLIENT_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:5000/api/v1
